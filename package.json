{
  "name": "nadir-sdk",
  "version": "0.1.2",
  "description": "Official Node.js SDK for the Nadir LLM router: picks the right model and effort for each request",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nadir",
    "llm",
    "router",
    "openai",
    "anthropic",
    "ai",
    "sdk"
  ],
  "author": "Nadir <info@getnadir.com>",
  "license": "MIT",
  "homepage": "https://getnadir.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/NadirRouter/nadir-node"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
